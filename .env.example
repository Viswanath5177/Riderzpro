# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/riderzpro

# Individual PostgreSQL Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=riderzpro

# Generic environment template. For local Cloudflare Worker development use
# .dev.vars.example as the source and copy it to .dev.vars instead.
# DATABASE_URL=file:./database/riderzpro-dev.db

# Server-only secrets. Generate independent random values for local/test/production.
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development

# OTP delivery. Configure at least one channel before enabling sign-in.
RESEND_API_KEY=
RESEND_FROM=Riderzpro <login@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
