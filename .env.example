# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/riderzpro

# Individual PostgreSQL Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=riderzpro

# Generic environment template. For local Cloudflare Worker development use
# .dev.vars.example as the source and copy it to .dev.vars instead.
# DATABASE_URL=file:./database/riderzpro-dev.db

# Server-only secrets & Auth
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development

# OTP delivery (Transactional Email / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=RiderzPro Support <your_email@gmail.com>

# Email OTP Constraints
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
