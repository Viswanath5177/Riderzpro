# ==============================================================================
# Riderzpro - Environment Variables Template
# Automatically generated when running `npm run dev` or `npm run setup`
# ==============================================================================

# SQLite Local Database (dev.db) - Operates without needing local PostgreSQL
DATABASE_URL=file:./dev.db

# Alternate PostgreSQL Connection Parameters (Optional / Staging)
# DATABASE_URL_PG=postgresql://postgres:password@localhost:5432/riderzpro

# Application Environment & OTP Configuration
APP_ENV=development
OTP_HASH_SECRET=7cd8990ebd204589e4747557dd11a73ea9881dd510466ebe83662b4d98846eb0
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# Resend API Configuration (Email Service)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=support@riderzpro.com

# Orders API & Buying Flow Configuration
# Mode: "mock" (sessionStorage fixtures), "live" (REST API), or "legacy" (in-memory store fallback)
VITE_ORDERS_API=live

# Razorpay (required for /api/payments/* — no fallback secrets in code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Admin / seller boards: set "true" only when intentionally using mock adapters
VITE_USE_MOCK_ADMIN_ORDERS=false
VITE_USE_MOCK_ADMIN_SELLERS=false
VITE_USE_MOCK_SELLER_ORDERS=false
VITE_USE_MOCK_SELLER_INVENTORY=false

# Twilio SMS Configuration (SMS Service)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=

# Google Maps / Places API Configuration (Optional - falls back to high-accuracy geocoding)
GOOGLE_MAPS_API_KEY=

