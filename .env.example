# =============================================================================
# Riderzpro Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed for local development.
# NEVER commit credentials, actual passwords, or API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Main PostgreSQL Connection URL (for local PostgreSQL database)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/riderzpro

# Individual PostgreSQL Connection Parameters (fallback if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=riderzpro

# -----------------------------------------------------------------------------
# Logistics & Live Tracking Subsystem Configuration
# -----------------------------------------------------------------------------
# FastAPI Backend URL (Logistics microservice running on port 8000)
FASTAPI_LOGISTICS_URL=http://127.0.0.1:8000
LOGISTICS_URL=http://127.0.0.1:8000

# Frontend Base API URL (consumed by browser client for REST & WebSocket derivation)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Open Source Routing Machine (OSRM) service URL for real-road navigation geometry
OSRM_API_URL=http://router.project-osrm.org

# Maximum corridor distance (meters) before triggering RIDER_ROUTE_DEVIATION event
ROUTE_DEVIATION_DISTANCE_METERS=250.0

# -----------------------------------------------------------------------------
# Server & Authentication
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
OTP_HASH_SECRET=replace-with-at-least-32-random-characters

# -----------------------------------------------------------------------------
# Mobile / Capacitor Development (Optional)
# -----------------------------------------------------------------------------
# VITE_APP_URL=http://10.0.2.2:8080
# CAPACITOR_SERVER_URL=http://10.0.2.2:8080

# -----------------------------------------------------------------------------
# Email & SMS Delivery (Optional - for OTP delivery)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Riderzpro <login@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Transactional Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=RiderzPro Support <your_email@gmail.com>

# Email OTP Constraints
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
